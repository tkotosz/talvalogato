{
  "name": "talvalogato",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:pages": "node scripts/build.mjs --pages",
    "dev": "node --watch --watch-preserve-output scripts/dev.mjs",
    "typecheck": "tsc -p . && tsc -p test",
    "test": "node --test test/*.test.ts",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/*.e2e.ts"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "lucide-react": "^1.77.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "domhandler": "5.0.3",
    "esbuild": "^0.28.2",
    "playwright-core": "1.65.0",
    "typescript": "7.0.2"
  }
}
