{
  "name": "talvalogato",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:pages": "node scripts/build.mjs --pages",
    "dev": "node --watch --watch-preserve-output scripts/dev.mjs",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "typecheck": "tsc -p . && tsc -p test",
    "test": "node --test test/*.test.ts",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/*.e2e.ts",
    "refresh-menu": "node scripts/refresh-menu.ts"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "lucide-react": "^1.77.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "domhandler": "5.0.3",
    "esbuild": "^0.28.2",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "playwright-core": "1.65.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
